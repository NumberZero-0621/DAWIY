{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dawiy",
  "version": "0.1.0",
  "identifier": "com.dawiy.app",
  "build": {
    "frontendDist": "../public/dist",
    "devUrl": "http://localhost:5002",
    "beforeDevCommand": null,
    "beforeBuildCommand": "cd ../public && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DAWIY",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}